SECRET_KEY=change-me
DEBUG=True

# Postgres local
DB_NAME=rutadelcacao
DB_USER=cacao
DB_PASSWORD=cacao
DB_HOST=localhost
DB_PORT=5432

# En local se deja vacío para usar las DB_* de arriba
DATABASE_URL=
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Autenticación
AUTH_JWT_SIGNING_KEY=change-me-with-an-independent-random-secret
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
FRONTEND_URL=http://localhost:3000
DEFAULT_FROM_EMAIL=no-reply@localhost

# Correo: consola en desarrollo; en producción, el backend del proveedor.
MAILER_BACKEND=django.core.mail.backends.console.EmailBackend
# MAILER_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=

# Proxies de confianza delante de la app. Debe ser 1 si la app está detrás de un solo proxy
# que agrega X-Forwarded-For, y 0 si no hay proxy. Con 0 detrás de un proxy, todos los
# clientes comparten la IP del proxy y el límite de solicitudes y el bloqueo de axes dejan
# de ser por cliente.
TRUSTED_PROXY_COUNT=0